le role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"font-size:11px; background-color:#111622; border:1px solid #1e2638; border-radius:6px; min-width:520px; overflow:hidden;\">\n                    <thead>\n                      <tr style=\"background-color:#161f30; color:#cbd5e1; font-size:10px; text-transform:uppercase; letter-spacing:0.05em;\">\n                        <th style=\"padding:8px 10px; text-align:left;\">Ticker</th>\n                        <th style=\"padding:8px 10px; text-align:left;\">Instrument</th>\n                        <th style=\"padding:8px 10px; text-align:right;\">Price</th>\n                        <th style=\"padding:8px 10px; text-align:center;\">Candle</th>\n                        <th style=\"padding:8px 10px; text-align:right;\">1H MACD</th>\n                        <th style=\"padding:8px 10px; text-align:right;\">Hist</th>\n                        <th style=\"padding:8px 10px; text-align:center;\">Action</th>\n                      </tr>\n                    </thead>\n                    <tbody>\n                      \n    <tr><td colspan=\"7\" style=\"padding:14px; text-align:center; color:#94a3b8;\">No fresh bearish breakdowns detected in this scan.</td></tr>\n    \n                    </tbody>\n                  </table>\n                </div>\n              </div>\n\n              <!-- RISK & EXECUTION PROTOCOL -->\n              <div style=\"margin-top:24px; padding:13px 15px; background-color:#0b0f17; border:1px solid #1e2638; border-radius:6px; font-size:11px; color:#cbd5e1; line-height:1.6;\">\n                <strong style=\"color:#ffffff;\">Execution &amp; Risk Protocol:</strong> Leveraged and inverse ETFs are subject to constant daily leverage resets and non-linear path decay (&Delta;V &approx; -&frac12;(k&sup2;-k)&sigma;&sup2;&Delta;t). Empirical multi-year backtests demonstrate that cash parking during bearish regimes outperforms continuous long/short flipping by over 300%. Maximum recommended holding duration is 30 market hours.\n              </div>\n\n              <!-- DASHBOARD CTA BUTTON -->\n              <div style=\"margin-top:20px; text-align:center;\">\n                <a href=\"https://yieldchaser.github.io/etf-data/markets.html?tab=flows&amp;view=macd_strategy\" target=\"_blank\" style=\"display:inline-block; background-color:#38bdf8; color:#0b0f17; font-weight:800; font-size:12px; text-transform:uppercase; letter-spacing:0.05em; padding:11px 24px; border-radius:4px; text-decoration:none;\">\n                  OPEN LIVE INTERACTIVE MACD DASHBOARD\n                </a>\n              </div>\n\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"padding:14px 20px; background-color:#090d15; border-top:1px solid #1e2638; font-size:10.5px; color:#94a3b8; text-align:center;\">\n              Conviction Labs &middot; 160 Curated Leveraged &amp; Inverse ETF Universe &middot; Quantitative Research Engine\n            </td>\n          </tr>\n\n        </table>\n\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
